{
  "name": "htp-decompress",
  "version": "0.1.1",
  "description": "gzip, xz and zstd decompression streams for the browser and Node, compiled from Rust to WebAssembly",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/four-random-common-words/htp-decompress.git",
    "directory": "npm"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build:wasm": "bash ../scripts/build-wasm.sh",
    "build": "npm run build:wasm && tsc -p tsconfig.build.json && cp ../LICENSE LICENSE && cp ../THIRD-PARTY-NOTICES.md THIRD-PARTY-NOTICES.md",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
